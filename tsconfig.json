{
  "compilerOptions": {
    "target": "ES2022", "module": "Preserve", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["bun"],
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
